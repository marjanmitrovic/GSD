# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# API security
JWT_SECRET=change-this-to-a-long-random-secret
PORT=4000

# Frontend API URL
# For local dev you may leave this empty because vite.config.js proxies /api to localhost:4000.
# For separated frontend/backend deploy, set the full backend URL.
VITE_API_URL=
